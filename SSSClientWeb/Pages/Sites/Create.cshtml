@page
@model SSSClientTickets.Pages.Sites.CreateModel
@{
    ViewData["Title"] = "Add Site";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Add Site</h2>
    <a asp-page="Index" class="btn btn-outline-secondary">← Back to Sites</a>
</div>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Site.ClientRec" class="form-label">Client</label>
                <select asp-for="Site.ClientRec" asp-items="Model.ClientList" class="form-select">
                    <option value="">-- Select a Client --</option>
                </select>
                <span asp-validation-for="Site.ClientRec" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Site.SiteName" class="form-label">Site Name</label>
                <input asp-for="Site.SiteName" class="form-control" />
                <span asp-validation-for="Site.SiteName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Site.SiteAddress1" class="form-label">Address Line 1</label>
                <input asp-for="Site.SiteAddress1" class="form-control" />
                <span asp-validation-for="Site.SiteAddress1" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Site.SiteAddress2" class="form-label">Address Line 2</label>
                <input asp-for="Site.SiteAddress2" class="form-control" />
                <span asp-validation-for="Site.SiteAddress2" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Site.SiteCity" class="form-label">City</label>
                    <input asp-for="Site.SiteCity" class="form-control" />
                    <span asp-validation-for="Site.SiteCity" class="text-danger"></span>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Site.SiteState" class="form-label">State</label>
                    <input asp-for="Site.SiteState" class="form-control" maxlength="2" />
                    <span asp-validation-for="Site.SiteState" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Site.SiteZip" class="form-label">Zip</label>
                    <input asp-for="Site.SiteZip" class="form-control" />
                    <span asp-validation-for="Site.SiteZip" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save Site</button>
            <a asp-page="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

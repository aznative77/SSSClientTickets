@page
@model SSSClientTickets.Pages.Sites.IndexModel
@{
    ViewData["Title"] = "Sites";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sites</h2>
    <a asp-page="Create" class="btn btn-primary">+ Add Site</a>
</div>

@if (!Model.Sites.Any())
{
    <div class="alert alert-info">No sites found. Add one to get started.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Site Name</th>
                <th>Client</th>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>Zip</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var site in Model.Sites)
            {
                <tr>
                    <td>@site.SiteName</td>
                    <td>@site.ClientRecNavigation?.ClientName</td>
                    <td>
                        @site.SiteAddress1
                        @if (!string.IsNullOrEmpty(site.SiteAddress2))
                        {
                            <br />@site.SiteAddress2
                        }
                    </td>
                    <td>@site.SiteCity</td>
                    <td>@site.SiteState</td>
                    <td>@site.SiteZip</td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@site.SiteRec" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@site.SiteRec" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

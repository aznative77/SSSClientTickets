@page
@model SSSClientWeb.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Customers</h2>
    <a asp-page="Create" class="btn btn-primary">+ Add Customer</a>
</div>

@if (!Model.Customers.Any())
{
    <div class="alert alert-info">No customers found. Add one to get started.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Customer Name</th>
                <th>Client</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Cell Phone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model.Customers)
            {
                <tr>
                    <td>@customer.CustomerName</td>
                    <td>@customer.ClientRecNavigation?.ClientName</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                    <td>@customer.Mobile</td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@customer.CustomerRec" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@customer.CustomerRec" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

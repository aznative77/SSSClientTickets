@page "{id:int}"
@model SSSClientWeb.Pages.TicketTime.DeleteModel
@{
    ViewData["Title"] = "Delete Time Entry";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Delete Time Entry</h2>
    <a asp-page="/Tickets/Detail" asp-route-id="@Model.TicketEntry.TicketRec" class="btn btn-outline-secondary">← Back to Ticket</a>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="alert alert-danger">
            Are you sure you want to delete this time entry? This cannot be undone.
        </div>

        <dl class="row">
            <dt class="col-sm-4">Ticket #</dt>
            <dd class="col-sm-8">@Model.TicketEntry.TicketRec</dd>

            <dt class="col-sm-4">Start Time</dt>
            <dd class="col-sm-8">@Model.TicketEntry.StartTime?.ToString("MM/dd/yyyy hh:mm tt")</dd>

            <dt class="col-sm-4">End Time</dt>
            <dd class="col-sm-8">@Model.TicketEntry.EndTime?.ToString("MM/dd/yyyy hh:mm tt")</dd>

            <dt class="col-sm-4">Duration</dt>
            <dd class="col-sm-8">
                @{
                    var duration = (Model.TicketEntry.StartTime.HasValue && Model.TicketEntry.EndTime.HasValue)
                        ? (int)(Model.TicketEntry.EndTime.Value - Model.TicketEntry.StartTime.Value).TotalMinutes
                        : 0;
                    var hours = duration / 60;
                    var minutes = duration % 60;
                }
                @hours hr @minutes min
            </dd>

            <dt class="col-sm-4">Notes</dt>
            <dd class="col-sm-8">@Model.TicketEntry.Notes</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="TicketEntry.TimeRec" />
            <input type="hidden" asp-for="TicketEntry.TicketRec" />
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-page="Edit" asp-route-id="@Model.TicketEntry.TimeRec" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

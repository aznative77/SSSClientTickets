@page
@model SSSClientWeb.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tickets</h2>
    <a asp-page="Create" class="btn btn-primary">+ Add Ticket</a>
</div>

@if (!Model.Tickets.Any())
{
    <div class="alert alert-info">No tickets found. Add one to get started.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Client</th>
                <th>Customer</th>
                <th>Issue</th>
                <th>Status</th>
                <th>Date Logged</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td>@ticket.TicketRec</td>
                    <td>@ticket.ClientRecNavigation?.ClientName</td>
                    <td>@ticket.CustomerRecNavigation?.CustomerName</td>
                    <td>
                        @if (ticket.Issue != null && ticket.Issue.Length > 60)
                        {
                            @(ticket.Issue.Substring(0, 60) + "...")
                        }
                        else
                        {
                            @ticket.Issue
                        }
                    </td>
                    <td>
                        @{
                            var badgeClass = ticket.StatusRecNavigation?.Status switch
                            {
                                "Open" => "bg-danger",
                                "In Progress" => "bg-warning text-dark",
                                "Resolved" => "bg-success",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@ticket.StatusRecNavigation?.Status</span>
                    </td>
                    <td>@ticket.DateLogged?.ToString("MM/dd/yyyy")</td>
                    <td class="text-end">
                        <a asp-page="Detail" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-page="Edit" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center mb-4">
    <h1 class="display-4">Welcome!</h1>
    <p class="lead">This is the SSS Client Support Log. Use the navigation above to manage clients, customers, sites, and support tickets.</p>
</div>

<div class="mb-4">
    <h2>Open Tickets</h2>
    @if (!Model.OpenTickets.Any())
    {
        <div class="alert alert-success">No open tickets. Great job!</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Client</th>
                    <th>Customer</th>
                    <th>Issue</th>
                    <th>Status</th>
                    <th>Date Logged</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model.OpenTickets)
                {
                    <tr>
                        <td>@ticket.TicketRec</td>
                        <td>@ticket.ClientRecNavigation?.ClientName</td>
                        <td>@ticket.CustomerRecNavigation?.CustomerName</td>
                        <td>
                            @if (ticket.Issue != null && ticket.Issue.Length > 60)
                            {
                                @(ticket.Issue.Substring(0, 60) + "...")
                            }
                            else
                            {
                                @ticket.Issue
                            }
                        </td>
                        <td>
                            @{
                                var badgeClass = ticket.StatusRecNavigation?.Status switch
                                {
                                    "Open" => "bg-danger",
                                    "In Progress" => "bg-warning text-dark",
                                    "Resolved" => "bg-success",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@ticket.StatusRecNavigation?.Status</span>
                        </td>
                        <td>@ticket.DateLogged?.ToString("MM/dd/yyyy")</td>
                        <td class="text-end">
                            <a asp-page="/Tickets/Detail" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Tickets/Edit" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-primary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

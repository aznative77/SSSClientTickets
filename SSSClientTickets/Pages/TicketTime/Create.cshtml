@page
@model SSSClientTickets.Pages.TicketTime.CreateModel
@{
    ViewData["Title"] = "Log Time";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Log Time — Ticket #@Model.TicketEntry.TicketRec</h2>
    <a asp-page="/Tickets/Detail" asp-route-id="@Model.TicketEntry.TicketRec" class="btn btn-outline-secondary">← Back to Ticket</a>
</div>

<div class="row">
    <div class="col-md-6">

        @if (Model.TicketInfo != null)
        {
            <div class="alert alert-secondary mb-4">
                <strong>@Model.TicketInfo.ClientRecNavigation?.ClientName</strong> —
                @Model.TicketInfo.CustomerRecNavigation?.CustomerName
                @if (!string.IsNullOrEmpty(Model.TicketInfo.SiteRecNavigation?.SiteName))
                {
                    <span>— @Model.TicketInfo.SiteRecNavigation.SiteName</span>
                }
                <br />
                <small class="text-muted">@Model.TicketInfo.Issue?.Substring(0, Math.Min(Model.TicketInfo.Issue.Length, 100))</small>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="TicketEntry.TicketRec" />
            <input type="hidden" asp-for="DateResolved" id="dateResolved" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="TicketEntry.StartTime" class="form-label">Start Time</label>
                    <input asp-for="TicketEntry.StartTime" value="@(Model.TicketEntry.StartTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" type="datetime-local" step="60" />
                    <span asp-validation-for="TicketEntry.StartTime" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TicketEntry.EndTime" class="form-label">End Time</label>
                    <input asp-for="TicketEntry.EndTime" value="@(Model.TicketEntry.EndTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" type="datetime-local" step="60" />
                    <span asp-validation-for="TicketEntry.EndTime" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="TicketEntry.Notes" class="form-label">Notes</label>
                <textarea asp-for="TicketEntry.Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="TicketEntry.Notes" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TicketStatusRec" class="form-label">Ticket Status</label>
                <select asp-for="TicketStatusRec" asp-items="Model.StatusList" class="form-select"></select>
                <span asp-validation-for="TicketStatusRec" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Time Entry</button>
            <a asp-page="/Tickets/Detail" asp-route-id="@Model.TicketEntry.TicketRec" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const statusSelect = document.getElementById('TicketStatusRec');
        const resolvedDate = document.getElementById('dateResolved');
        const oldResolvedDate = '@(Model.TicketInfo?.DateResolved?.ToString("yyyy-MM-dd") ?? "")';
        statusSelect.addEventListener('change', function () {
            if (this.options[this.selectedIndex].text.trim().toLowerCase() !== 'resolved') return;
            const startDate = document.getElementById('TicketEntry_StartTime').value;
            const endDate = document.getElementById('TicketEntry_EndTime').value;
            const proposed = (endDate || startDate || new Date().toISOString()).slice(0, 10);
            const displayDate = new Date(proposed + 'T00:00:00').toLocaleDateString();
            const oldDisplayDate = oldResolvedDate ? new Date(oldResolvedDate + 'T00:00:00').toLocaleDateString() : null;
            const message = oldDisplayDate
                ? `Would you like to update the Resolved Date from ${oldDisplayDate} to ${displayDate}?`
                : `Would you like to set the Resolved Date to ${displayDate}?`;
            askYesNo(message).then(yes => { if (yes) resolvedDate.value = proposed; });
        });

        function askYesNo(message) {
            return new Promise(resolve => {
                const dialog = document.createElement('dialog');
                dialog.innerHTML = '<form method="dialog" style="min-width: 300px"><p></p><div style="display:flex;justify-content:flex-end;gap:.5rem"><button value="no" class="btn btn-outline-secondary">No</button><button value="yes" class="btn btn-primary">Yes</button></div></form>';
                dialog.querySelector('p').textContent = message;
                dialog.addEventListener('close', () => { const yes = dialog.returnValue === 'yes'; dialog.remove(); resolve(yes); }, { once: true });
                document.body.appendChild(dialog);
                dialog.showModal();
            });
        }
    </script>
}

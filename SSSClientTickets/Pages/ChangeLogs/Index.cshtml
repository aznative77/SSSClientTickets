@page
@model SSSClientTickets.Pages.ChangeLogs.IndexModel
@{
    ViewData["Title"] = "Change Log";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Change Log</h2>
</div>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>User</th>
            <th>Area</th>
            <th>Record</th>
            <th>Action</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ChangeLogs)
        {
            <tr>
                <td>@item.ChangedAt.ToString("MM/dd/yyyy hh:mm tt")</td>
                <td>@(item.User?.FullName ?? item.User?.Email ?? "Unknown")</td>
                <td>@item.EntityName</td>
                <td>@item.EntityRecordId</td>
                <td>@item.Action</td>
                <td>@item.Description</td>
            </tr>
        }
    </tbody>
</table>

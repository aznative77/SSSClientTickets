@page "{id:int}"
@model SSSClientTickets.Pages.Tickets.EditModel
@{
    ViewData["Title"] = "Edit Ticket #" + Model.Ticket.TicketRec;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Edit Ticket #@Model.Ticket.TicketRec</h2>
    <a asp-page="Index" class="btn btn-outline-secondary">← Back to Tickets</a>
</div>

<div class="row">
    <div class="col-md-7">
        <form method="post">
            <input type="hidden" asp-for="Ticket.TicketRec" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Ticket.ClientRec" class="form-label">Client</label>
                    <select asp-for="Ticket.ClientRec" asp-items="Model.ClientList" class="form-select"></select>
                    <span asp-validation-for="Ticket.ClientRec" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Ticket.CustomerRec" class="form-label">Customer</label>
                    <select asp-for="Ticket.CustomerRec" asp-items="Model.CustomerList" class="form-select"></select>
                    <span asp-validation-for="Ticket.CustomerRec" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.SiteRec" class="form-label">Site <span class="text-muted">(optional)</span></label>
                <select asp-for="Ticket.SiteRec" asp-items="Model.SiteList" class="form-select">
                    <option value="">-- Select a Site --</option>
                </select>
                <span asp-validation-for="Ticket.SiteRec" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.HourlyRate" class="form-label">Hourly Rate</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Ticket.HourlyRate" class="form-control" type="number" min="0" step="0.01" />
                </div>
                <span asp-validation-for="Ticket.HourlyRate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.Issue" class="form-label">Issue</label>
                <textarea asp-for="Ticket.Issue" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Ticket.Issue" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.Resolution" class="form-label">Resolution</label>
                <textarea asp-for="Ticket.Resolution" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Ticket.Resolution" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Ticket.StatusRec" class="form-label">Status</label>
                    <select asp-for="Ticket.StatusRec" asp-items="Model.StatusList" class="form-select"></select>
                    <span asp-validation-for="Ticket.StatusRec" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Ticket.DateLogged" class="form-label">Date Logged</label>
                    <input asp-for="Ticket.DateLogged" class="form-control" type="date" />
                    <span asp-validation-for="Ticket.DateLogged" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Ticket.DateResolved" class="form-label">Date Resolved</label>
                    <input asp-for="Ticket.DateResolved" class="form-control" type="date" />
                    <span asp-validation-for="Ticket.DateResolved" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.DateBilled" class="form-label">Date Billed</label>
                <input asp-for="Ticket.DateBilled" class="form-control" type="date" />
                <span asp-validation-for="Ticket.DateBilled" class="text-danger"></span>
            </div>

            <!-- File Upload Section -->
            <div class="card mb-3">
                <div class="card-header">
                    <strong>Attachments</strong>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="fileUpload" class="form-label">Upload File</label>
                        <input type="file" class="form-control" id="fileUpload" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.txt,.csv" />
                        <small class="form-text text-muted">Max size: 50MB. Allowed: JPG, PNG, GIF, WEBP, BMP, PDF, DOC, DOCX, XLS, XLSX, TXT, CSV</small>
                    </div>
                    <div id="uploadProgress" class="d-none">
                        <div class="progress mb-2">
                            <div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                    <button type="button" id="uploadBtn" class="btn btn-sm btn-success">Upload</button>
                    <div id="uploadStatus" class="mt-2"></div>
                    <div id="attachmentsList" class="mt-3"></div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="Detail" asp-route-id="@Model.Ticket.TicketRec" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

<style>
    .attachment-item {
        display: flex;
        align-items: center;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        margin-bottom: 8px;
        background-color: #f9f9f9;
    }

    .attachment-item .file-icon {
        font-size: 24px;
        margin-right: 12px;
        min-width: 30px;
        text-align: center;
    }

    .attachment-item .file-info {
        flex: 1;
    }

    .attachment-item .file-name {
        font-weight: 500;
        color: #333;
    }

    .attachment-item .file-meta {
        font-size: 12px;
        color: #666;
        margin-top: 2px;
    }

    .attachment-item .delete-btn {
        margin-left: auto;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const ticketId = @Model.Ticket.TicketRec;

        document.getElementById('uploadBtn').addEventListener('click', async function() {
            const fileInput = document.getElementById('fileUpload');
            const file = fileInput.files[0];

            if (!file) {
                alert('Please select a file');
                return;
            }

            const formData = new FormData();
            formData.append('ticketRec', ticketId);
            formData.append('file', file);

            const uploadProgress = document.getElementById('uploadProgress');
            const progressBar = document.getElementById('progressBar');
            const uploadStatus = document.getElementById('uploadStatus');

            uploadProgress.classList.remove('d-none');
            progressBar.style.width = '0%';

            try {
                const xhr = new XMLHttpRequest();

                xhr.upload.addEventListener('progress', function(e) {
                    if (e.lengthComputable) {
                        const percentComplete = (e.loaded / e.total) * 100;
                        progressBar.style.width = percentComplete + '%';
                    }
                });

                xhr.addEventListener('load', function() {
                    if (xhr.status === 200) {
                        uploadStatus.innerHTML = '<div class="alert alert-success">File uploaded successfully!</div>';
                        fileInput.value = '';
                        loadAttachments();
                    } else {
                        const message = getUploadErrorMessage(xhr);
                        uploadStatus.innerHTML = `<div class="alert alert-danger">${escapeHtml(message)}</div>`;
                    }
                    uploadProgress.classList.add('d-none');
                });

                xhr.addEventListener('error', function() {
                    uploadStatus.innerHTML = '<div class="alert alert-danger">Upload error</div>';
                    uploadProgress.classList.add('d-none');
                });

                xhr.open('POST', '/api/attachments/upload');
                xhr.send(formData);
            } catch (error) {
                uploadStatus.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
                uploadProgress.classList.add('d-none');
            }
        });

        function getUploadErrorMessage(xhr) {
            if (!xhr.responseText) {
                return `Upload failed with status ${xhr.status}`;
            }

            try {
                const response = JSON.parse(xhr.responseText);
                return response.message || response.title || response.error || xhr.responseText;
            } catch {
                return xhr.responseText;
            }
        }

        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }

        function getFileIcon(fileName, isImage) {
            const ext = fileName.split('.').pop().toLowerCase();
            if (isImage) return '🖼️';
            switch(ext) {
                case 'pdf': return '📄';
                case 'doc':
                case 'docx': return '📝';
                case 'xls':
                case 'xlsx': return '📊';
                case 'txt': return '📃';
                default: return '📎';
            }
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        async function loadAttachments() {
            try {
                const response = await fetch(`/api/attachments/ticket/${ticketId}`);
                const attachments = await response.json();
                const attachmentsList = document.getElementById('attachmentsList');

                if (attachments.length === 0) {
                    attachmentsList.innerHTML = '<p class="text-muted">No files attached yet.</p>';
                    return;
                }

                attachmentsList.innerHTML = attachments.map(att => `
                    <div class="attachment-item">
                        <div class="file-icon">${getFileIcon(att.fileName, att.isImage)}</div>
                        <div class="file-info">
                            <div class="file-name">${escapeHtml(att.fileName)}</div>
                            <div class="file-meta">Uploaded: ${new Date(att.uploadedDate).toLocaleDateString()}</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-btn" onclick="deleteAttachment(${att.attachmentRec})">
                            Delete
                        </button>
                    </div>
                `).join('');
            } catch (error) {
                console.error('Error loading attachments:', error);
            }
        }

        async function deleteAttachment(attachmentRec) {
            if (!confirm('Are you sure you want to delete this file?')) return;

            try {
                const response = await fetch(`/api/attachments/delete/${attachmentRec}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    loadAttachments();
                } else {
                    alert('Failed to delete file');
                }
            } catch (error) {
                console.error('Error deleting file:', error);
                alert('Error deleting file');
            }
        }

        // Load attachments when page loads
        document.addEventListener('DOMContentLoaded', loadAttachments);
    </script>
}

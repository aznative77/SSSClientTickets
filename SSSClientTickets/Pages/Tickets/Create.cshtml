@page
@model SSSClientTickets.Pages.Tickets.CreateModel
@{
    ViewData["Title"] = "Add Ticket";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Add Ticket</h2>
    <a asp-page="Index" class="btn btn-outline-secondary">← Back to Tickets</a>
</div>

<div class="row">
    <div class="col-md-7">
        <form method="post">
            <input type="hidden" asp-for="HourlyRateWasChanged" id="hourlyRateWasChanged" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Ticket.ClientRec" class="form-label">Client</label>
                    <select asp-for="Ticket.ClientRec" asp-items="Model.ClientList" class="form-select" id="clientSelect">
                        <option value="">-- Select a Client --</option>
                    </select>
                    <span asp-validation-for="Ticket.ClientRec" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Ticket.CustomerRec" class="form-label">Customer</label>
                    <div class="input-group">
                        <select asp-for="Ticket.CustomerRec" asp-items="Model.CustomerList" class="form-select" id="customerSelect">
                            <option value="">-- Select a Customer --</option>
                        </select>
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addCustomerModal" id="addCustomerBtn">
                            <i class="bi bi-plus-circle"></i> Add New
                        </button>
                    </div>
                    <span asp-validation-for="Ticket.CustomerRec" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.SiteRec" class="form-label">Site <span class="text-muted">(optional)</span></label>
                <div class="input-group">
                    <select asp-for="Ticket.SiteRec" asp-items="Model.SiteList" class="form-select" id="siteSelect">
                        <option value="">-- Select a Site --</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addSiteModal" id="addSiteBtn">
                        <i class="bi bi-plus-circle"></i> Add New
                    </button>
                </div>
                <span asp-validation-for="Ticket.SiteRec" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.HourlyRate" class="form-label">Hourly Rate</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Ticket.HourlyRate" class="form-control" type="number" min="0" step="0.01" id="hourlyRateInput" />
                </div>
                <span asp-validation-for="Ticket.HourlyRate" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Ticket.IsFlatRate" class="form-check-input" />
                <label asp-for="Ticket.IsFlatRate" class="form-check-label">Flat rate / manual total</label>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.Issue" class="form-label">Issue</label>
                <textarea asp-for="Ticket.Issue" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Ticket.Issue" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.Resolution" class="form-label">Resolution</label>
                <textarea asp-for="Ticket.Resolution" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Ticket.Resolution" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label asp-for="Ticket.StatusRec" class="form-label">Status</label>
                    <select asp-for="Ticket.StatusRec" asp-items="Model.StatusList" class="form-select"></select>
                    <span asp-validation-for="Ticket.StatusRec" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Ticket.AssignedToUserId" class="form-label">Assigned To</label>
                    <select asp-for="Ticket.AssignedToUserId" asp-items="Model.UserList" class="form-select"></select>
                    <span asp-validation-for="Ticket.AssignedToUserId" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Ticket.DateLogged" class="form-label">Date Logged</label>
                    <input asp-for="Ticket.DateLogged" class="form-control" type="date" />
                    <span asp-validation-for="Ticket.DateLogged" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Ticket.DateResolved" class="form-label">Date Resolved</label>
                    <input asp-for="Ticket.DateResolved" class="form-control" type="date" />
                    <span asp-validation-for="Ticket.DateResolved" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save Ticket</button>
            <a asp-page="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

<!-- Add Customer Modal -->
<div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCustomerModalLabel">Add New Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addCustomerForm">
                <div class="modal-body">
                    <div id="customerValidationSummary" class="text-danger mb-3" style="display: none;"></div>
                    
                    <div class="mb-3">
                        <label for="customerName" class="form-label">Customer Name *</label>
                        <input type="text" class="form-control" id="customerName" required>
                        <div class="invalid-feedback">Customer name is required.</div>
                    </div>

                    <div class="mb-3">
                        <label for="customerEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="customerEmail">
                    </div>

                    <div class="mb-3">
                        <label for="customerPhone" class="form-label">Phone</label>
                        <input type="tel" class="form-control" id="customerPhone">
                    </div>

                    <div class="mb-3">
                        <label for="customerMobile" class="form-label">Cell Phone</label>
                        <input type="tel" class="form-control" id="customerMobile">
                    </div>

                    <div class="mb-3">
                        <label for="customerClient" class="form-label">Client *</label>
                        <select class="form-select" id="customerClient" required>
                            <option value="">-- Select a Client --</option>
                            @foreach (var client in Model.ClientList)
                            {
                                <option value="@client.Value">@client.Text</option>
                            }
                        </select>
                        <div class="invalid-feedback">Client is required.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveCustomerBtn">Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Site Modal -->
<div class="modal fade" id="addSiteModal" tabindex="-1" aria-labelledby="addSiteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSiteModalLabel">Add New Site</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addSiteForm">
                <div class="modal-body">
                    <div id="siteValidationSummary" class="text-danger mb-3" style="display: none;"></div>
                    
                    <div class="mb-3">
                        <label for="siteClient" class="form-label">Client *</label>
                        <select class="form-select" id="siteClient" required>
                            <option value="">-- Select a Client --</option>
                            @foreach (var client in Model.ClientList)
                            {
                                <option value="@client.Value">@client.Text</option>
                            }
                        </select>
                        <div class="invalid-feedback">Client is required.</div>
                    </div>

                    <div class="mb-3">
                        <label for="siteName" class="form-label">Site Name *</label>
                        <input type="text" class="form-control" id="siteName" required>
                        <div class="invalid-feedback">Site name is required.</div>
                    </div>

                    <div class="mb-3">
                        <label for="siteAddress1" class="form-label">Address Line 1</label>
                        <input type="text" class="form-control" id="siteAddress1">
                    </div>

                    <div class="mb-3">
                        <label for="siteAddress2" class="form-label">Address Line 2</label>
                        <input type="text" class="form-control" id="siteAddress2">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="siteCity" class="form-label">City</label>
                            <input type="text" class="form-control" id="siteCity">
                        </div>
                        <div class="col-md-2 mb-3">
                            <label for="siteState" class="form-label">State</label>
                            <input type="text" class="form-control" id="siteState" maxlength="2">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="siteZip" class="form-label">Zip</label>
                            <input type="text" class="form-control" id="siteZip">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveSiteBtn">Save Site</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Handle Add Customer Form
            $('#addCustomerForm').on('submit', function(e) {
                e.preventDefault();
                
                // Clear previous validation
                $('#customerValidationSummary').hide();
                $('#addCustomerForm .is-invalid').removeClass('is-invalid');
                
                const customerName = $('#customerName').val();
                const customerEmail = $('#customerEmail').val();
                const customerPhone = $('#customerPhone').val();
                const customerMobile = $('#customerMobile').val();
                const customerClientRec = parseInt($('#customerClient').val());

                const customerData = {
                    'Customer.CustomerName': customerName,
                    'Customer.Email': customerEmail,
                    'Customer.Phone': customerPhone,
                    'Customer.Mobile': customerMobile,
                    'Customer.ClientRec': customerClientRec
                };
                
                // Basic client-side validation
                let isValid = true;
                if (!customerName?.trim()) {
                    $('#customerName').addClass('is-invalid');
                    isValid = false;
                }
                if (!customerClientRec) {
                    $('#customerClient').addClass('is-invalid');
                    isValid = false;
                }
                
                if (!isValid) return;
                
                $('#saveCustomerBtn').prop('disabled', true).text('Saving...');
                
                $.ajax({
                    url: '/Customers/Create?handler=Ajax',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    data: customerData,
                    success: function(response) {
                        if (response.success) {
                            // Refresh customer dropdown
                            refreshCustomerDropdown(response.customerRec, response.customerName);
                            $('#addCustomerModal').modal('hide');
                            resetCustomerForm();
                        } else {
                            $('#customerValidationSummary').text(response.message || 'An error occurred').show();
                        }
                    },
                    error: function(xhr) {
                        const errorMessage = xhr.responseJSON?.message || 'An error occurred while saving the customer.';
                        $('#customerValidationSummary').text(errorMessage).show();
                    },
                    complete: function() {
                        $('#saveCustomerBtn').prop('disabled', false).text('Save Customer');
                    }
                });
            });
            
            // Handle Add Site Form
            $('#addSiteForm').on('submit', function(e) {
                e.preventDefault();
                
                // Clear previous validation
                $('#siteValidationSummary').hide();
                $('#addSiteForm .is-invalid').removeClass('is-invalid');
                
                const siteClientRec = parseInt($('#siteClient').val());
                const siteName = $('#siteName').val();
                const siteAddress1 = $('#siteAddress1').val();
                const siteAddress2 = $('#siteAddress2').val();
                const siteCity = $('#siteCity').val();
                const siteState = $('#siteState').val();
                const siteZip = $('#siteZip').val();

                const siteData = {
                    'Site.ClientRec': siteClientRec,
                    'Site.SiteName': siteName,
                    'Site.SiteAddress1': siteAddress1,
                    'Site.SiteAddress2': siteAddress2,
                    'Site.SiteCity': siteCity,
                    'Site.SiteState': siteState,
                    'Site.SiteZip': siteZip
                };
                
                // Basic client-side validation
                let isValid = true;
                if (!siteName?.trim()) {
                    $('#siteName').addClass('is-invalid');
                    isValid = false;
                }
                if (!siteClientRec) {
                    $('#siteClient').addClass('is-invalid');
                    isValid = false;
                }
                
                if (!isValid) return;
                
                $('#saveSiteBtn').prop('disabled', true).text('Saving...');
                
                $.ajax({
                    url: '/Sites/Create?handler=Ajax',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    data: siteData,
                    success: function(response) {
                        if (response.success) {
                            // Refresh site dropdown
                            refreshSiteDropdown(response.siteRec, response.siteName);
                            $('#addSiteModal').modal('hide');
                            resetSiteForm();
                        } else {
                            $('#siteValidationSummary').text(response.message || 'An error occurred').show();
                        }
                    },
                    error: function(xhr) {
                        const errorMessage = xhr.responseJSON?.message || 'An error occurred while saving the site.';
                        $('#siteValidationSummary').text(errorMessage).show();
                    },
                    complete: function() {
                        $('#saveSiteBtn').prop('disabled', false).text('Save Site');
                    }
                });
            });
            
            // Reset forms when modals are hidden
            $('#addCustomerModal').on('hidden.bs.modal', function() {
                resetCustomerForm();
            });
            
            $('#addSiteModal').on('hidden.bs.modal', function() {
                resetSiteForm();
            });
            
            // Update site client dropdown when main client is selected
            $('#clientSelect').on('change', function() {
                const selectedClient = $(this).val();
                $('#siteClient').val(selectedClient);
                refreshHourlyRate(selectedClient);
            });

            $('#hourlyRateInput').on('input', function() {
                $('#hourlyRateWasChanged').val('true');
            });
        });

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function refreshHourlyRate(clientId) {
            if (!clientId) {
                $('#hourlyRateInput').val('0.00');
                $('#hourlyRateWasChanged').val('false');
                return;
            }

            $.ajax({
                url: `/api/tickets/client-hourly-rate?clientId=${clientId}`,
                type: 'GET',
                success: function(response) {
                    const rate = Number(response.hourlyRate || 0);
                    $('#hourlyRateInput').val(rate.toFixed(2));
                    $('#hourlyRateWasChanged').val('false');
                }
            });
        }
        
        function refreshCustomerDropdown(newCustomerRec, newCustomerName) {
            const option = new Option(newCustomerName, newCustomerRec, false, true);
            $('#customerSelect').append(option).trigger('change');
        }
        
        function refreshSiteDropdown(newSiteRec, newSiteName) {
            const option = new Option(newSiteName, newSiteRec, false, true);
            $('#siteSelect').append(option).trigger('change');
        }
        
        function resetCustomerForm() {
            $('#addCustomerForm')[0].reset();
            $('#addCustomerForm .is-invalid').removeClass('is-invalid');
            $('#customerValidationSummary').hide();
        }
        
        function resetSiteForm() {
            $('#addSiteForm')[0].reset();
            $('#addSiteForm .is-invalid').removeClass('is-invalid');
            $('#siteValidationSummary').hide();
            // Reset site client to match main form
            $('#siteClient').val($('#clientSelect').val());
        }
    </script>
}

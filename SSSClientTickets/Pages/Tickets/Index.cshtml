@page
@model SSSClientTickets.Pages.Tickets.IndexModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tickets</h2>
    <a asp-page="Create" class="btn btn-primary">+ Add Ticket</a>
</div>

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Filter Tickets</h5>
        <button class="btn btn-sm btn-outline-secondary filter-toggle-button" type="button" data-bs-toggle="collapse" data-bs-target="#filterTicketsBody" aria-expanded="false" aria-controls="filterTicketsBody">
            Show filters
        </button>
    </div>
    <div class="collapse" id="filterTicketsBody">
        <div class="card-body">
        <form method="get" asp-page="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <div class="dropdown" id="statusDropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="statusButton" data-bs-toggle="dropdown" aria-expanded="false">
                        Select Statuses
                    </button>
                    <ul class="dropdown-menu w-100" aria-labelledby="statusButton">
                        @foreach (var status in Model.StatusOptions)
                        {
                            <li class="px-3 py-2">
                                <div class="form-check">
                                    <input class="form-check-input status-checkbox" type="checkbox" value="@status.Value" id="status_@status.Value" name="FilterStatusRec" @(Model.FilterStatusRec?.Contains(int.Parse(status.Value)) == true ? "checked" : "")>
                                    <label class="form-check-label" for="status_@status.Value">
                                        @status.Text
                                    </label>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-md-3">
                <label for="FilterClientRec" class="form-label">Client</label>
                <select class="form-select" id="FilterClientRec" name="FilterClientRec" asp-items="Model.ClientOptions" asp-for="FilterClientRec">
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Customer</label>
                <div class="dropdown" id="customerDropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="customerButton" data-bs-toggle="dropdown" aria-expanded="false">
                        Select Customers
                    </button>
                    <ul class="dropdown-menu w-100" aria-labelledby="customerButton" id="customerDropdownMenu">
                        @foreach (var customer in Model.CustomerOptions)
                        {
                            <li class="px-3 py-2">
                                <div class="form-check">
                                    <input class="form-check-input customer-checkbox" type="checkbox" value="@customer.Value" id="customer_@customer.Value" name="FilterCustomerRec" @(Model.FilterCustomerRec?.Contains(int.Parse(customer.Value)) == true ? "checked" : "")>
                                    <label class="form-check-label" for="customer_@customer.Value">
                                        @customer.Text
                                    </label>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-md-3">
                <label for="FilterIssueSearch" class="form-label">Issue Search</label>
                <input type="text" class="form-control" id="FilterIssueSearch" name="FilterIssueSearch" placeholder="Search issue..." asp-for="FilterIssueSearch">
            </div>

            <fieldset class="col-md-4 date-filter-fieldset">
                <legend class="form-label fs-6">Date Logged</legend>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label for="FilterDateLoggedFrom" class="form-label">From</label>
                        <input type="date" class="form-control" id="FilterDateLoggedFrom" name="FilterDateLoggedFrom" asp-for="FilterDateLoggedFrom">
                    </div>

                    <div class="col-md-6">
                        <label for="FilterDateLoggedTo" class="form-label">To</label>
                        <input type="date" class="form-control" id="FilterDateLoggedTo" name="FilterDateLoggedTo" asp-for="FilterDateLoggedTo">
                    </div>
                </div>
            </fieldset>

            <fieldset class="col-md-4 date-filter-fieldset">
                <legend class="form-label fs-6">Date Resolved</legend>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label for="FilterDateResolvedFrom" class="form-label">From</label>
                        <input type="date" class="form-control" id="FilterDateResolvedFrom" name="FilterDateResolvedFrom" asp-for="FilterDateResolvedFrom">
                    </div>

                    <div class="col-md-6">
                        <label for="FilterDateResolvedTo" class="form-label">To</label>
                        <input type="date" class="form-control" id="FilterDateResolvedTo" name="FilterDateResolvedTo" asp-for="FilterDateResolvedTo">
                    </div>
                </div>
            </fieldset>

            <fieldset class="col-md-4 date-filter-fieldset">
                <legend class="form-label fs-6">Date Billed</legend>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label for="FilterDateBilledFrom" class="form-label">From</label>
                        <input type="date" class="form-control" id="FilterDateBilledFrom" name="FilterDateBilledFrom" asp-for="FilterDateBilledFrom">
                    </div>

                    <div class="col-md-6">
                        <label for="FilterDateBilledTo" class="form-label">To</label>
                        <input type="date" class="form-control" id="FilterDateBilledTo" name="FilterDateBilledTo" asp-for="FilterDateBilledTo">
                    </div>

                    <div class="col-12">
                        <div class="date-filter-or" aria-hidden="true">or</div>
                        <div class="form-check not-yet-billed-filter">
                            <input class="form-check-input" type="checkbox" id="FilterNotYetBilled" name="FilterNotYetBilled" value="true" asp-for="FilterNotYetBilled">
                            <label class="form-check-label" for="FilterNotYetBilled">
                                Not Yet Billed
                            </label>
                        </div>
                    </div>
                </div>
            </fieldset>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply Filters</button>
                <a asp-page="Index" class="btn btn-secondary">Clear Filters</a>
            </div>
        </form>
        </div>
    </div>
</div>

@if (!Model.Tickets.Any())
{
    <div class="alert alert-info">No tickets found. Add one to get started.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Client</th>
                <th>Customer</th>
                <th>Issue</th>
                <th>Rate</th>
                <th>Status</th>
                <th>Date Logged</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td>@ticket.TicketRec</td>
                    <td>@ticket.ClientRecNavigation?.ClientName</td>
                    <td>@ticket.CustomerRecNavigation?.CustomerName</td>
                    <td>
                        @if (ticket.Issue != null && ticket.Issue.Length > 60)
                        {
                            @(ticket.Issue.Substring(0, 60) + "...")
                        }
                        else
                        {
                            @ticket.Issue
                        }
                    </td>
                    <td>@ticket.HourlyRate.ToString("C")</td>
                    <td>
                        @{
                            var badgeClass = ticket.StatusRecNavigation?.Status switch
                            {
                                "Open" => "bg-danger",
                                "In Progress" => "bg-warning text-dark",
                                "Waiting for Client" => "bg-info text-dark",
                                "Resolved" => "bg-success",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@ticket.StatusRecNavigation?.Status</span>
                    </td>
                    <td>@ticket.DateLogged?.ToString("MM/dd/yyyy")</td>
                    <td class="text-end">
                        <a asp-page="Detail" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-page="Edit" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@ticket.TicketRec" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<script>
    // Update button text to show selected count for Status
    function updateStatusButtonText() {
        const checkedCount = document.querySelectorAll('.status-checkbox:checked').length;
        const button = document.getElementById('statusButton');
        
        if (checkedCount === 0) {
            button.textContent = 'Select Statuses';
        } else {
            button.textContent = checkedCount + (checkedCount === 1 ? ' Status' : ' Statuses') + ' Selected';
        }
    }
    
    // Update button text to show selected count for Customer
    function updateCustomerButtonText() {
        const checkedCount = document.querySelectorAll('.customer-checkbox:checked').length;
        const button = document.getElementById('customerButton');
        
        if (checkedCount === 0) {
            button.textContent = 'Select Customers';
        } else {
            button.textContent = checkedCount + (checkedCount === 1 ? ' Customer' : ' Customers') + ' Selected';
        }
    }
    
    // Load customers for selected client
    async function loadCustomersByClient() {
        const clientSelect = document.getElementById('FilterClientRec');
        const clientId = clientSelect.value;
        
        if (!clientId) {
            // Clear all customer checkboxes
            document.querySelectorAll('.customer-checkbox').forEach(cb => cb.checked = false);
            updateCustomerButtonText();
            return;
        }
        
        try {
            const response = await fetch(`/api/tickets/customers-by-client?clientId=${clientId}`);
            const customers = await response.json();
            
            const dropdownMenu = document.getElementById('customerDropdownMenu');
            dropdownMenu.innerHTML = '';
            
            if (customers.length === 0) {
                dropdownMenu.innerHTML = '<li class="px-3 py-2"><em>No customers for this client</em></li>';
            } else {
                customers.forEach(customer => {
                    const li = document.createElement('li');
                    li.className = 'px-3 py-2';
                    li.innerHTML = `
                        <div class="form-check">
                            <input class="form-check-input customer-checkbox" type="checkbox" value="${customer.value}" id="customer_${customer.value}" name="FilterCustomerRec">
                            <label class="form-check-label" for="customer_${customer.value}">
                                ${customer.text}
                            </label>
                        </div>
                    `;
                    dropdownMenu.appendChild(li);
                    
                    // Add event listener to new checkbox
                    li.querySelector('.customer-checkbox').addEventListener('change', updateCustomerButtonText);
                    li.addEventListener('click', function(e) {
                        e.stopPropagation();
                    });
                });
            }
            
            updateCustomerButtonText();
        } catch (error) {
            console.error('Error loading customers:', error);
        }
    }
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        updateStatusButtonText();
        updateCustomerButtonText();
        
        // Add change listeners to status checkboxes
        document.querySelectorAll('.status-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateStatusButtonText);
        });
        
        // Prevent dropdown from closing when clicking on status checkboxes
        document.querySelectorAll('#statusDropdown .dropdown-menu li').forEach(li => {
            li.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });
        
        // Add change listeners to customer checkboxes
        document.querySelectorAll('.customer-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateCustomerButtonText);
        });
        
        // Prevent dropdown from closing when clicking on customer checkboxes
        document.querySelectorAll('#customerDropdown .dropdown-menu li').forEach(li => {
            li.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });
        
        // Add listener to client select
        const clientSelect = document.getElementById('FilterClientRec');
        clientSelect.addEventListener('change', loadCustomersByClient);

        const filterTicketsBody = document.getElementById('filterTicketsBody');
        const filterToggleButton = document.querySelector('.filter-toggle-button');

        filterTicketsBody.addEventListener('shown.bs.collapse', function() {
            filterToggleButton.textContent = 'Hide filters';
            filterToggleButton.setAttribute('aria-expanded', 'true');
        });

        filterTicketsBody.addEventListener('hidden.bs.collapse', function() {
            filterToggleButton.textContent = 'Show filters';
            filterToggleButton.setAttribute('aria-expanded', 'false');
        });
    });
</script>
